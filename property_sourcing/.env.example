# ===================== Property Sourcing Autopilot — config =====================
# Copy this file to `.env` and fill in what you have. Every value has a free-tier
# or zero-cost option. Nothing here is required to run the demo.

# ---- LLM brain for the AI agents (optional) ----
# Leave LLM_PROVIDER=none to run with the built-in rule-based "AI-lite" engine
# (no signup, no cost, works immediately). Upgrade any time for smarter writing
# and analysis by picking a free-tier provider below.
LLM_PROVIDER=none            # none | groq | openai | anthropic
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant   # sensible default for Groq's free tier

# ---- Companies House (free API key — https://developer.company-information.service.gov.uk/) ----
COMPANIES_HOUSE_API_KEY=

# ---- Land Registry Price Paid Data ----
# No API key needed — it's fully open government data. You can optionally
# override the base URL or point at a local cached file.
LAND_REGISTRY_CACHE_DIR=./data/land_registry_cache

# ---- Auction feed sources (optional) ----
# Comma-separated list of public RSS/JSON auction catalogue URLs you have
# checked are OK to poll under each site's terms of use. Leave blank to skip.
AUCTION_FEED_URLS=

# ---- Outreach email (free Gmail account works) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=                # use a Gmail "App Password", not your real password
SMTP_FROM_NAME=Your Sourcing Business
SMTP_FROM_EMAIL=
# Daily digest of new deals, sent to you so your involvement stays low.
DIGEST_TO_EMAIL=

# Safety switch: while true, outreach emails are only written to the database
# as drafts and never actually sent. Flip to false once you trust the output.
DRY_RUN_OUTREACH=true

# ---- Deal scoring thresholds ----
MIN_BMV_PERCENT=15            # minimum "below market value" % to flag a hot deal
MIN_ROI_PERCENT=12            # minimum projected cash-on-cash ROI to flag a hot deal

# ---- Dashboard ----
FLASK_SECRET_KEY=change-me
DASHBOARD_PORT=8000
